    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mongoose": "^9.11.4",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
